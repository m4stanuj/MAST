# MAST environment template
# Copy this file to config/.env or .env depending on your local setup.
# Never commit real API keys.

# Smart key slots auto-detect providers by prefix when supported.
SMART_KEY_1=your_groq_or_provider_key_here
SMART_KEY_2=your_second_provider_key_here
SMART_KEY_3=your_third_provider_key_here

# Optional direct provider keys.
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=

# Local model fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Local services and storage.
MAST_HOST=127.0.0.1
MAST_PORT=8765
MAST_DATA_DIR=./data
MAST_LOG_LEVEL=INFO

# Security workflow scope.
# Use localhost, owned lab targets, CTF targets, or written-permission audit targets only.
MAST_ALLOWED_TARGETS=localhost,127.0.0.1
MAST_REQUIRE_AUTHORIZED_SCOPE=true

# Messaging / notification integrations.
TELEGRAM_BOT_TOKEN=
MAST_ALLOWED_CHAT_IDS=
